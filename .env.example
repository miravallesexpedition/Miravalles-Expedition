# Configuración de variables de entorno
# Copiá este archivo a .env.local y completá los valores con tus credenciales.

# URL pública de la aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Usa una de estas dos opciones:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opcional y solo para servidor/Vercel, nunca publicar en navegador:
SUPABASE_SECRET_KEY=

# PayPal (opcional, si deseas activar pagos por PayPal)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_SECRET_KEY=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# Resend para envío de correos
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@miravallesexpedition.com

# Panel privado de reservas
ADMIN_ACCESS_TOKEN=
MAX_PARTICIPANTS_PER_SLOT=10

# WhatsApp / contacto
NEXT_PUBLIC_WHATSAPP_NUMBER=50670063382
NEXT_PUBLIC_CONTACT_EMAIL=reservas.miravallesexpedition@gmail.com

# Google Maps API (opcional, para el mapa interactivo)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
