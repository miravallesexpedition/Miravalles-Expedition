# Configuración de Variables de Entorno
# Copia este archivo a .env.local y completa los valores con tus credenciales.

# URL pública de la aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PayPal (opcional, si deseas activar pagos por PayPal)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_SECRET_KEY=

# Resend para envío de correos
RESEND_API_KEY=

# WhatsApp Business API
NEXT_PUBLIC_WHATSAPP_NUMBER=+506XXXXXXXX

# Google Maps API (opcional, para el mapa interactivo)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Email de contacto
NEXT_PUBLIC_CONTACT_EMAIL=info@miravallles.cr
