# Configuración de Variables de Entorno
# Copia este archivo a .env.local y completa los valores

# WhatsApp Business API
NEXT_PUBLIC_WHATSAPP_NUMBER=+506XXXXXXXX

# Stripe (obtén estas claves en https://stripe.com)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_XXXXXXXX
STRIPE_SECRET_KEY=sk_test_XXXXXXXX

# Google Maps API (opcional, para el mapa interactivo)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Email de contacto
NEXT_PUBLIC_CONTACT_EMAIL=info@miravalesexpedition.com
